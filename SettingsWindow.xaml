<Window x:Class="ClickyWindows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky setup"
        Width="620" Height="720" MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#0F1218"
        Foreground="#F4F7FB"
        FontFamily="Segoe UI"
        ShowInTaskbar="True">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#171C25"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A3342"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#96A0AF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E131B"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="CaretBrush" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#344052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0E131B"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="CaretBrush" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#344052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0E131B"/>
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="BorderBrush" Value="#344052"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE3ED"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8D0DC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F7FB"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#222A36"/>
            <Setter Property="Foreground" Value="#E7ECF3"/>
            <Setter Property="BorderBrush" Value="#344052"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,22,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Set up Clicky" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Your screen is captured only when you use push-to-talk."
                           Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#172F24" BorderBrush="#285A40"
                    BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#55D98A" Margin="0,0,7,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="#8BE5AC" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,12">
            <StackPanel>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AI services" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="AI provider" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ProviderBox" SelectionChanged="OnProviderChanged">
                            <ComboBoxItem Content="Gemini"/>
                            <ComboBoxItem Content="Anthropic"/>
                        </ComboBox>
                        <TextBlock x:Name="ProviderHint" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <StackPanel x:Name="GeminiKeySection">
                            <TextBlock Text="Gemini API key" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <PasswordBox x:Name="GeminiKeyBox" PasswordChanged="OnInputChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="AnthropicKeySection">
                            <TextBlock Text="Anthropic API key" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <PasswordBox x:Name="AnthropicKeyBox" PasswordChanged="OnInputChanged"/>
                        </StackPanel>
                        <TextBlock Text="AssemblyAI API key" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                        <PasswordBox x:Name="AssemblyKeyBox" PasswordChanged="OnInputChanged"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ElevenLabs API key" Style="{StaticResource FieldLabel}"/>
                                <PasswordBox x:Name="ElevenKeyBox" PasswordChanged="OnInputChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Voice ID" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="VoiceIdBox" TextChanged="OnInputChanged"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ModelLabel" Text="AI model" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                        <ComboBox x:Name="ModelBox" IsEditable="True" SelectionChanged="OnInputChanged">
                            <ComboBoxItem Content="gemini-3.6-flash"/>
                            <ComboBoxItem Content="claude-sonnet-4-6"/>
                            <ComboBoxItem Content="claude-opus-4-6"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="7" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Push-to-talk and overlay" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Shortcut" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="HotkeyBox" SelectionChanged="OnInputChanged">
                            <ComboBoxItem Tag="6,32" Content="Ctrl + Shift + Space"/>
                            <ComboBoxItem Tag="3,32" Content="Ctrl + Alt + Space"/>
                            <ComboBoxItem Tag="5,32" Content="Alt + Shift + Space"/>
                            <ComboBoxItem Tag="10,32" Content="Ctrl + Win + Space"/>
                        </ComboBox>
                        <CheckBox x:Name="ShowOverlayBox" Content="Show Clicky beside the cursor"
                                  Margin="0,16,0,0" Checked="OnInputChanged" Unchecked="OnInputChanged"/>
                    </StackPanel>
                </Border>

                <Expander Header="Advanced proxy settings" Foreground="#DCE3ED" Margin="2,2,2,8">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="18" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Claude proxy URL" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ClaudeProxyBox" TextChanged="OnInputChanged"/>
                            <TextBlock Text="ElevenLabs proxy URL" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <TextBox x:Name="ElevenProxyBox" TextChanged="OnInputChanged"/>
                            <TextBlock Text="AssemblyAI token URL (reserved)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                            <TextBox x:Name="AssemblyTokenBox" TextChanged="OnInputChanged"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Border x:Name="ValidationPanel" Background="#2A1A1D" BorderBrush="#6C3038"
                        BorderThickness="1" CornerRadius="6" Padding="12" Visibility="Collapsed">
                    <TextBlock x:Name="ValidationText" Foreground="#FFB1BA" TextWrapping="Wrap" FontSize="12"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="#131821" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Open settings folder" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Margin="24,14,0,14" Click="OpenSettingsFolder"/>
            <Button Grid.Column="1" Content="Cancel" Margin="0,14,0,14"
                    Style="{StaticResource SecondaryButton}" Click="CancelClick"/>
            <Button Grid.Column="3" x:Name="SaveButton" Content="Save and start Clicky"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"
                    Padding="18,9" Margin="0,14,24,14" FontWeight="SemiBold" Cursor="Hand" Click="SaveClick"/>
        </Grid>
    </Grid>
</Window>
