<Window x:Class="ClickyWindows.ScreenSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select screen area" WindowStyle="None" AllowsTransparency="True"
        Background="#01000000" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Cursor="Cross" PreviewKeyDown="WindowPreviewKeyDown">
    <Canvas x:Name="SelectionCanvas"
            MouseLeftButtonDown="CanvasMouseLeftButtonDown"
            MouseMove="CanvasMouseMove"
            MouseLeftButtonUp="CanvasMouseLeftButtonUp">
        <Rectangle x:Name="FullDim" Fill="#82030A0F"/>
        <Rectangle x:Name="DimTop" Fill="#82030A0F" Visibility="Collapsed"/>
        <Rectangle x:Name="DimBottom" Fill="#82030A0F" Visibility="Collapsed"/>
        <Rectangle x:Name="DimLeft" Fill="#82030A0F" Visibility="Collapsed"/>
        <Rectangle x:Name="DimRight" Fill="#82030A0F" Visibility="Collapsed"/>
        <Border x:Name="SelectionBox" Visibility="Collapsed" BorderBrush="#00D2FF"
                BorderThickness="2" Background="Transparent" CornerRadius="1">
            <Border.Effect>
                <DropShadowEffect Color="#00D2FF" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/>
            </Border.Effect>
        </Border>
    </Canvas>
</Window>
