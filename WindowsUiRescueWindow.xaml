<Window x:Class="ClickyWindows.WindowsUiRescueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky Windows rescue"
        Width="430" Height="492"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#10141B"
        Foreground="#F4F7FB"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#171D27"/>
        <SolidColorBrush x:Key="Border" Color="#2B3646"/>
        <SolidColorBrush x:Key="Muted" Color="#9CA8B8"/>
        <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#232C39"/>
            <Setter Property="Foreground" Value="#EAF0F7"/>
            <Setter Property="BorderBrush" Value="#344258"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" Background="#18365E" CornerRadius="17">
                <Ellipse Width="12" Height="12" Fill="#77B4FF"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="CLICKY WINDOWS RESCUE" Foreground="#86B9FF" FontSize="10" FontWeight="Bold"/>
                <TextBlock Text="Small fixes, one step at a time" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="×" Width="30" Height="30" FontSize="20"
                    Background="Transparent" BorderThickness="0" Foreground="#AEB9C7"
                    Cursor="Hand" Click="CloseClick" ToolTip="Close"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="7" Padding="17" Margin="0,20,0,14">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" FontSize="13"
                           TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Text="TRY THIS" Foreground="#7E8CA0" FontSize="10" FontWeight="Bold" Margin="2,0,0,9"/>
            <ItemsControl x:Name="StepsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="22" Height="22" CornerRadius="11" Background="#23334A">
                                <TextBlock Text="{Binding Number}" Foreground="#A8CDFE" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="#DCE4EE" FontSize="13"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <Border x:Name="ConfirmationPanel" Background="#2B2022" BorderBrush="#6B4247" BorderThickness="1"
                    CornerRadius="6" Padding="11" Visibility="Collapsed" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="ConfirmationText" Foreground="#FFD0D5" FontSize="12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Click="CancelConfirmationClick"/>
                        <Button Content="Confirm" Background="#D6505E" Foreground="White" BorderThickness="0"
                                Padding="14,9" Margin="8,0,0,0" Cursor="Hand" FontWeight="SemiBold"
                                Click="ConfirmClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PrimaryActionButton" Background="{StaticResource Accent}" Foreground="White"
                        BorderThickness="0" Padding="14,10" Cursor="Hand" FontWeight="SemiBold" Click="PrimaryActionClick"/>
                <Button x:Name="SecondaryActionButton" Grid.Column="2" Style="{StaticResource SecondaryButton}"
                        Click="SecondaryActionClick"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
